# Dashboard Supabase > Project Settings / Connect > API URL + Publishable key.
# Both values are public; authorization is enforced by database RLS and RPCs.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_public_key
# Optional GitHub Pages project-site path; use / for a username.github.io site.
# VITE_BASE_PATH=/your-repository-name/
# VITE_USE_HASH_ROUTER=true
# Local CLI legacy anon JWT is also accepted via the variable above.
# Never use sb_secret_* or a service_role JWT in VITE_* variables.
