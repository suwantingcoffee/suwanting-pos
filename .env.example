APP_NAME="Suwanting Coffee POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
# SQLite: default demo lokal; database/database.sqlite dibuat saat setup.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=suwanting_pos
# DB_USERNAME=suwanting
# DB_PASSWORD=
# Supabase: gunakan host/user dari Connect > Session pooler.
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require
# DB_SCHEMA=pos
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
POS_DEMO_MODE=true
POS_SIMULATE_PAYMENTS=true
VITE_APP_NAME="Suwanting Coffee POS"
